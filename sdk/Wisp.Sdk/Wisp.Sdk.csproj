<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Wisp.Sdk</PackageId>
    <Version>0.1.1-bootstrap</Version>
    <Authors>ebifriedrice</Authors>
    <Description>MSBuild SDK for Wisp projects.</Description>
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Sdk.props" Pack="true" PackagePath="Sdk" />
    <None Include="Sdk.targets" Pack="true" PackagePath="Sdk" />
  </ItemGroup>
</Project>
