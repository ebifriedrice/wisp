<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Wisp.Cli</RootNamespace>
    <AssemblyName>wisp</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wisp</ToolCommandName>
    <PackageId>Wisp.Cli</PackageId>
    <Version>0.1.3-bootstrap</Version>
    <Authors>ebifriedrice</Authors>
    <Description>Wisp language CLI and project runner.</Description>
    <PackageTags>wisp;lisp;dotnet;clojure</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Repl.fs" />
    <Compile Include="Tui.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
    <PackageReference Include="Terminal.Gui.Editor" Version="2.5.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Wisp.Core/Wisp.Core.fsproj" />
    <ProjectReference Include="../Wisp.Reader/Wisp.Reader.fsproj" />
    <ProjectReference Include="../Wisp.Compiler/Wisp.Compiler.fsproj" />
  </ItemGroup>
</Project>
